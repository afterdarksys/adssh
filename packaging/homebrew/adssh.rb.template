class Adssh < Formula
  desc "Security-first programmable DevOps shell and governed SSH gateway"
  homepage "https://github.com/afterdarksys/adssh"
  version "{{VERSION}}"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/afterdarksys/adssh/releases/download/{{VERSION}}/adssh_{{VERSION}}_darwin_arm64.tar.gz"
      sha256 "{{DARWIN_ARM64_SHA256}}"
    else
      url "https://github.com/afterdarksys/adssh/releases/download/{{VERSION}}/adssh_{{VERSION}}_darwin_amd64.tar.gz"
      sha256 "{{DARWIN_AMD64_SHA256}}"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/afterdarksys/adssh/releases/download/{{VERSION}}/adssh_{{VERSION}}_linux_arm64.tar.gz"
      sha256 "{{LINUX_ARM64_SHA256}}"
    else
      url "https://github.com/afterdarksys/adssh/releases/download/{{VERSION}}/adssh_{{VERSION}}_linux_amd64.tar.gz"
      sha256 "{{LINUX_AMD64_SHA256}}"
    end
  end

  def install
    bin.install "bin/adssh"
    bin.install "bin/adssh-mcp"
    man1.install "man/adssh.1"
    bash_completion.install "completions/adssh.bash" => "adssh"
    zsh_completion.install "completions/adssh.zsh" => "_adssh"
    pkgshare.install "policy"
  end

  test do
    assert_match "adssh", shell_output("#{bin}/adssh --version")
  end
end
